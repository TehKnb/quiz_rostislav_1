# Copy to .env.local for local work. In production, set these in Railway Variables.
BUSINESS_REVIEW_WEBHOOK_URL=
OPENAI_API_KEY=
# Meta Pixel ID (digits only); without it the pixel is not added.
PIXEL_ID=
